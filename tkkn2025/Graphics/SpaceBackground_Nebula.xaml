<UserControl
    x:Class="tkkn2025.Graphics.SpaceBackground_Nebula"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <!--  Linear Layer  -->
        <Rectangle Name="LinearLayer">
            <Rectangle.Fill>
                <LinearGradientBrush x:Name="LinearBrush" StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#44000000" />
                    <GradientStop Offset="1" Color="#44300030" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--  Radial Layer 1  -->
        <Rectangle Name="RadialLayer1">
            <Rectangle.Fill>
                <RadialGradientBrush x:Name="RadialBrush1" Center="0.5,0.5" GradientOrigin="0.3,0.3" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Offset="0" Color="#33181818" />
                    <GradientStop Offset="1" Color="#22300030" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--  Radial Layer 2  -->
        <Rectangle Name="RadialLayer2">
            <Rectangle.Fill>
                <RadialGradientBrush x:Name="RadialBrush2" Center="0.5,0.5" GradientOrigin="0.7,0.7" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Offset="0" Color="#44401040" />
                    <GradientStop Offset="1" Color="#22000000" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!--  Cloud Shapes  -->
        <Canvas Name="CloudCanvas">
            <!--  Cloud 1 - Much larger  -->
            <Path
                Name="Cloud1"
                Canvas.Left="50"
                Canvas.Top="20">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="80,120">
                            <BezierSegment
                                Point1="20,120"
                                Point2="20,60"
                                Point3="80,60" />
                            <BezierSegment
                                Point1="100,20"
                                Point2="160,20"
                                Point3="180,60" />
                            <BezierSegment
                                Point1="240,30"
                                Point2="300,50"
                                Point3="320,100" />
                            <BezierSegment
                                Point1="340,80"
                                Point2="360,100"
                                Point3="340,140" />
                            <BezierSegment
                                Point1="360,170"
                                Point2="320,190"
                                Point3="280,180" />
                            <BezierSegment
                                Point1="240,200"
                                Point2="200,190"
                                Point3="180,160" />
                            <BezierSegment
                                Point1="140,180"
                                Point2="100,170"
                                Point3="80,120" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.Fill>
                    <RadialGradientBrush x:Name="CloudBrush1" Center="0.5,0.5" GradientOrigin="0.4,0.4" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Offset="0" Color="#55252525" />
                        <GradientStop Offset="0.7" Color="#22101010" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>

            <!--  Cloud 2 - Much larger  -->
            <Path
                Name="Cloud2"
                Canvas.Left="250"
                Canvas.Top="140">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="60,90">
                            <BezierSegment
                                Point1="10,90"
                                Point2="10,40"
                                Point3="60,40" />
                            <BezierSegment
                                Point1="70,10"
                                Point2="110,10"
                                Point3="120,40" />
                            <BezierSegment
                                Point1="160,20"
                                Point2="200,30"
                                Point3="210,70" />
                            <BezierSegment
                                Point1="230,60"
                                Point2="240,80"
                                Point3="230,100" />
                            <BezierSegment
                                Point1="240,120"
                                Point2="210,130"
                                Point3="180,124" />
                            <BezierSegment
                                Point1="150,140"
                                Point2="120,134"
                                Point3="110,110" />
                            <BezierSegment
                                Point1="80,124"
                                Point2="50,116"
                                Point3="60,90" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.Fill>
                    <RadialGradientBrush x:Name="CloudBrush2" Center="0.5,0.5" GradientOrigin="0.3,0.6" RadiusX="0.9" RadiusY="0.7">
                        <GradientStop Offset="0" Color="#44301530" />
                        <GradientStop Offset="0.6" Color="#22151515" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>

            <!--  Cloud 3 - Much larger  -->
            <Path
                Name="Cloud3"
                Canvas.Left="420"
                Canvas.Top="240">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="100,140">
                            <BezierSegment
                                Point1="30,140"
                                Point2="30,70"
                                Point3="100,70" />
                            <BezierSegment
                                Point1="120,30"
                                Point2="180,30"
                                Point3="200,70" />
                            <BezierSegment
                                Point1="260,40"
                                Point2="320,50"
                                Point3="340,100" />
                            <BezierSegment
                                Point1="370,90"
                                Point2="390,110"
                                Point3="370,150" />
                            <BezierSegment
                                Point1="390,180"
                                Point2="350,200"
                                Point3="300,190" />
                            <BezierSegment
                                Point1="260,210"
                                Point2="220,200"
                                Point3="200,160" />
                            <BezierSegment
                                Point1="160,190"
                                Point2="120,180"
                                Point3="100,140" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.Fill>
                    <RadialGradientBrush x:Name="CloudBrush3" Center="0.5,0.5" GradientOrigin="0.6,0.3" RadiusX="0.85" RadiusY="0.8">
                        <GradientStop Offset="0" Color="#66202020" />
                        <GradientStop Offset="0.65" Color="#33101010" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>

            <!--  Cloud 4 - Much larger  -->
            <Path
                Name="Cloud4"
                Canvas.Left="580"
                Canvas.Top="60">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="70,110">
                            <BezierSegment
                                Point1="20,110"
                                Point2="20,50"
                                Point3="70,50" />
                            <BezierSegment
                                Point1="80,20"
                                Point2="120,20"
                                Point3="130,50" />
                            <BezierSegment
                                Point1="160,30"
                                Point2="190,40"
                                Point3="200,80" />
                            <BezierSegment
                                Point1="220,70"
                                Point2="230,90"
                                Point3="220,110" />
                            <BezierSegment
                                Point1="80,180"
                                Point2="100,220"
                                Point3="90,250" />
                            <BezierSegment
                                Point1="100,270"
                                Point2="80,280"
                                Point3="60,270" />
                            <BezierSegment
                                Point1="30,280"
                                Point2="10,260"
                                Point3="20,230" />
                            <BezierSegment
                                Point1="10,190"
                                Point2="30,150"
                                Point3="70,110" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.Fill>
                    <RadialGradientBrush x:Name="CloudBrush4" Center="0.5,0.5" GradientOrigin="0.5,0.2" RadiusX="0.75" RadiusY="0.9">
                        <GradientStop Offset="0" Color="#55402040" />
                        <GradientStop Offset="0.7" Color="#22201020" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>

            <!--  Cloud 5 - Much larger  -->
            <Path
                Name="Cloud5"
                Canvas.Left="150"
                Canvas.Top="280">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="90,130">
                            <BezierSegment
                                Point1="30,130"
                                Point2="30,70"
                                Point3="90,70" />
                            <BezierSegment
                                Point1="110,30"
                                Point2="170,30"
                                Point3="190,70" />
                            <BezierSegment
                                Point1="250,50"
                                Point2="300,60"
                                Point3="310,110" />
                            <BezierSegment
                                Point1="340,100"
                                Point2="350,120"
                                Point3="340,140" />
                            <BezierSegment
                                Point1="350,170"
                                Point2="320,190"
                                Point3="280,180" />
                            <BezierSegment
                                Point1="240,200"
                                Point2="200,190"
                                Point3="190,150" />
                            <BezierSegment
                                Point1="150,170"
                                Point2="110,160"
                                Point3="90,130" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.Fill>
                    <RadialGradientBrush x:Name="CloudBrush5" Center="0.5,0.5" GradientOrigin="0.7,0.5" RadiusX="0.8" RadiusY="0.85">
                        <GradientStop Offset="0" Color="#44252525" />
                        <GradientStop Offset="0.65" Color="#22121212" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>

            <!--  Cloud 6 - Much larger  -->
            <Path
                Name="Cloud6"
                Canvas.Left="380"
                Canvas.Top="30">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="80,100">
                            <BezierSegment
                                Point1="30,100"
                                Point2="30,50"
                                Point3="80,50" />
                            <BezierSegment
                                Point1="90,20"
                                Point2="130,20"
                                Point3="140,50" />
                            <BezierSegment
                                Point1="180,30"
                                Point2="220,40"
                                Point3="230,80" />
                            <BezierSegment
                                Point1="260,70"
                                Point2="280,90"
                                Point3="270,110" />
                            <BezierSegment
                                Point1="280,130"
                                Point2="250,140"
                                Point3="220,134" />
                            <BezierSegment
                                Point1="180,150"
                                Point2="140,140"
                                Point3="130,110" />
                            <BezierSegment
                                Point1="90,124"
                                Point2="50,114"
                                Point3="80,100" />
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
                <Path.Fill>
                    <RadialGradientBrush x:Name="CloudBrush6" Center="0.5,0.5" GradientOrigin="0.2,0.7" RadiusX="0.95" RadiusY="0.6">
                        <GradientStop Offset="0" Color="#77301530" />
                        <GradientStop Offset="0.6" Color="#33151515" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Path.Fill>
            </Path>
        </Canvas>
    </Grid>
</UserControl>